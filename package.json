{
  "name": "eve-at-draft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "data:fetch": "tsx ./tools/data-pipeline/cli.ts fetch 2026",
    "data:build": "tsx ./tools/data-pipeline/cli.ts build 2026",
    "data:validate": "tsx ./tools/data-pipeline/cli.ts validate 2026",
    "data:refresh": "tsx ./tools/data-pipeline/cli.ts refresh 2026",
    "tools:validate": "tsx ./tools/validate-data.ts",
    "build": "node ./tools/check-node-version.mjs && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "primevue": "^4.5.4",
    "vue": "^3.5.21",
    "vue-i18n": "^11.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/opencc-js": "^1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-dom": "^3.5.21",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^30.0.1",
    "opencc-js": "^1.0.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "yarn@4.9.4",
  "resolutions": {
    "postcss": "^8.5.18",
    "brace-expansion": "^5.0.10",
    "js-cookie": "^3.0.7",
    "ip-address": "^10.2.0",
    "glob": "^13.0.6",
    "tar": "^7.5.21",
    "undici": "^7.29.1",
    "nanoid": "^3.3.18"
  }
}
